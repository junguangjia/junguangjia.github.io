source 'https://rubygems.org'

# GitHub Pages builds this site with the gem versions pinned by `github-pages`
# (https://pages.github.com/versions/). Using the same gem locally keeps the
# local preview and the published site consistent.
gem 'github-pages', group: :jekyll_plugins

group :jekyll_plugins do
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
end

# Required by `jekyll serve` on Ruby 3.x
gem 'webrick', '~> 1.8'

# Pin carried over from the upstream template
gem 'connection_pool', '2.5.0'
